+    # =========================================================================
+    # Workspace 实例注册表（per-request 多 workspace 路由的后端）
+    # =========================================================================
+    # LIGHTRAG-WORKSPACE 头经 WorkspaceContextMiddleware 解析后写入请求级
+    # contextvar，并由 middleware 在进入 endpoint 前完成实例懒加载；
+    # 下方两个代理把 router 内既有的 rag/doc_manager 调用透明路由到对应
+    # workspace 的实例——router 代码零改动。
+    _default_workspace = args.workspace or ""
+    _ws_instances: dict = {}  # workspace -> LightRAG（默认 workspace 用 rag，不入表）
+    _ws_locks: dict = {}      # workspace -> asyncio.Lock（防首请求并发重复创建）
+    _ws_registry_lock = asyncio.Lock()
+
+    async def get_rag_for_workspace(workspace):
+        """按 workspace 获取 LightRAG 实例（懒加载 + per-workspace 锁）。
+
+        默认 workspace（含未携带 header 的请求）直接返回全局 rag 单例，
+        零额外开销；其余 workspace 首次访问时用与全局实例相同的配置创建，
+        并完成 initialize_storages / check_and_migrate_data 初始化。
+        """
+        if not workspace or workspace == _default_workspace:
+            return rag
+        cached = _ws_instances.get(workspace)
+        if cached is not None:
+            return cached
+        async with _ws_registry_lock:
+            lock = _ws_locks.setdefault(workspace, asyncio.Lock())
+        async with lock:
+            cached = _ws_instances.get(workspace)
+            if cached is not None:
+                return cached
+            logger.info(f"[Workspace] 懒加载 LightRAG 实例: workspace={workspace}")
+            instance = LightRAG(**_build_rag_kwargs(workspace))
+            instance.register_role_llm_builder(
+                lambda role, meta: (
+                    create_role_llm_func(role, meta),
+                    create_role_llm_model_kwargs(role, meta),
+                )
+            )
+            await instance.initialize_storages()
+            await instance.check_and_migrate_data()
+            _ws_instances[workspace] = instance
+            logger.info(f"[Workspace] 实例就绪: workspace={workspace}")
+            return instance
+
+    def _resolve_rag_for_current_request():
+        """同步解析当前请求应使用的 rag（middleware 已保证懒加载完成）。"""
+        workspace = _request_workspace_ctx.get()
+        if not workspace or workspace == _default_workspace:
+            return rag
+        instance = _ws_instances.get(workspace)
+        if instance is None:
+            # 兜底：middleware ensure 失败（fail-open 回退）或绕过 middleware
+            # 的调用路径。回退默认实例并记告警，避免属性访问抛 500。
+            logger.warning(
+                f"[Workspace] 实例未就绪 workspace={workspace}，回退默认 workspace"
+            )
+            return rag
+        return instance
+
+    class WorkspaceRAGProxy:
+        """把属性访问按请求 contextvar 路由到对应 workspace 的 LightRAG 实例。
+
+        router 拿到的“rag”即本代理：方法/属性调用透明转发，async 方法
+        在调用点才产生协程，与直接持有实例无差别。默认 workspace 走全局
+        单例零开销路径。
+        """
+
+        def __getattr__(self, name):
+            return getattr(_resolve_rag_for_current_request(), name)
+
+        def __setattr__(self, name, value):
+            setattr(_resolve_rag_for_current_request(), name, value)
+
+    class WorkspaceDocManagerProxy:
+        """按请求 contextvar 路由到对应 workspace 的 DocumentManager（轻量缓存）。"""
+
+        _dm_cache: dict = {}
+
+        def _resolve(self):
+            workspace = _request_workspace_ctx.get() or _default_workspace
+            manager = self._dm_cache.get(workspace)
+            if manager is None:
+                manager = DocumentManager(args.input_dir, workspace=workspace)
+                self._dm_cache[workspace] = manager
+            return manager
+
+        def __getattr__(self, name):
+            return getattr(self._resolve(), name)
+
+        def __setattr__(self, name, value):
+            if name == "_dm_cache":
+                object.__setattr__(self, name, value)
+                return
+            setattr(self._resolve(), name, value)
