+
+_WORKSPACE_SANITIZE_RE = re.compile(r"[^a-zA-Z0-9_]")
+
+
+def _sanitize_workspace_header(value: str):
+    """消毒 workspace 标识（防注入/路径遍历，与上游 #2792 同一套规则）。"""
+    cleaned = (value or "").strip()
+    if not cleaned:
+        return None
+    sanitized = _WORKSPACE_SANITIZE_RE.sub("_", cleaned)
+    if sanitized != cleaned:
+        logger.warning(
+            f"Workspace header '{cleaned}' contains invalid characters. "
+            f"Sanitized to '{sanitized}'."
+        )
+    return sanitized
+
+
+class WorkspaceContextMiddleware:
+    """ASGI middleware：解析 LIGHTRAG-WORKSPACE 头，写入请求级 contextvar。
+
+    携带 workspace 头的请求在进入 endpoint 前由 ``ensure_instance`` 回调
+    完成对应 LightRAG 实例的懒加载，保证代理层同步查表必命中。
+    非 HTTP scope（lifespan/websocket）直接透传；请求结束复位 contextvar，
+    避免连接复用串扰。
+    """
+
+    def __init__(self, app, ensure_instance=None):
+        self.app = app
+        self.ensure_instance = ensure_instance  # async callable(workspace) -> Any
+
+    async def __call__(self, scope, receive, send):
+        if scope["type"] != "http":
+            await self.app(scope, receive, send)
+            return
+
+        workspace = None
+        for key, value in scope.get("headers") or []:
+            if key.lower() == b"lightrag-workspace":
+                workspace = _sanitize_workspace_header(
+                    value.decode("utf-8", errors="replace")
+                )
+                break
+
+        if workspace and self.ensure_instance is not None:
+            try:
+                await self.ensure_instance(workspace)
+            except Exception:
+                # 实例创建失败时按默认 workspace 继续（fail-open），
+                # 由 endpoint 的错误处理返回业务错误，而非中间件 500。
+                logger.exception(
+                    f"[Workspace] 实例懒加载失败 workspace={workspace}，回退默认 workspace"
+                )
+                workspace = None
+
+        token = _request_workspace_ctx.set(workspace)
+        try:
+            await self.app(scope, receive, send)
+        finally:
+            _request_workspace_ctx.reset(token)
 auth_configured = bool(auth_handler.accounts)
 
 
