# ==============================================================================
# Langfuse 自部署配置模板
# 使用: cp .env.example .env，然后逐项修改标【!】的值
# 密钥生成命令（Git Bash / Linux 通用）:
#   openssl rand -hex 32   → NEXTAUTH_SECRET / SALT（各生成一个）
#   openssl rand -hex 32   → ENCRYPTION_KEY（必须是 64 位十六进制，生成一次即可）
#   openssl rand -base64 24 → 各类密码
# ==============================================================================

# 【!】Langfuse Web 访问端口（宿主机），前端 3000 已被占用故默认 3100
LANGFUSE_PORT=3100

# 【!】必须与实际访问地址完全一致（含端口），否则登录后跳转会错
NEXTAUTH_URL=http://192.168.60.X:3100

# 【!】以下三个密钥用 openssl rand -hex 32 各生成一个
NEXTAUTH_SECRET=CHANGE_ME_hex64
SALT=CHANGE_ME_hex64
ENCRYPTION_KEY=CHANGE_ME_hex64

# 【!】基础设施密码（Langfuse 独立实例，勿与业务数据库共用口令）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=langfuse
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGE_ME
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGE_ME_at_least_8_chars

# ---------- 首启自动初始化（免手工创建） ----------
# 【!】管理员账号（首次启动后请立即登录并修改密码）
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=CHANGE_ME_login_password

# 【!】项目 API Key——Agent 侧 .env 的 LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY 与这里保持一致
# 格式要求：pk-lf- 前缀 + 自定义串 / sk-lf- 前缀 + 自定义串
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-CHANGE_ME
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-CHANGE_ME

# 组织/项目标识（一般无需修改）
LANGFUSE_INIT_ORG_ID=jingzhi
LANGFUSE_INIT_ORG_NAME=精智未来
LANGFUSE_INIT_PROJECT_ID=ai-test-agent
LANGFUSE_INIT_PROJECT_NAME=AI智能测试平台
